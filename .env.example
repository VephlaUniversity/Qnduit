# Backend configuration. Copy to backend/.env and supply your own values.
# Never commit backend/.env. Do not use production credentials for local work.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/qnduit_local?replicaSet=rs0
JWT_SECRET=replace_with_a_long_random_local_secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# SendGrid: needed for application email (use a verified sender).
SENDGRID_API_KEY=replace_with_sendgrid_test_key
SENDGRID_FROM_EMAIL=sender@example.invalid
CONTACT_RECEIVER_EMAIL=contact@example.invalid

# Flutterwave: use sandbox credentials, plan IDs and callback URLs locally.
FLW_SECRET_KEY=replace_with_flutterwave_test_key
FLW_SECRET_HASH=replace_with_webhook_secret_hash
FLW_TALENT_PUBLIC_PLAN_ID=replace_with_test_plan_id
FLW_EMPLOYER_BRONZE_PLAN_ID=replace_with_test_plan_id
FLW_EMPLOYER_SILVER_PLAN_ID=replace_with_test_plan_id
FLW_EMPLOYER_PLATINUM_PLAN_ID=replace_with_test_plan_id

# Cloudinary media; attachments additionally need private staging and indexes.
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_test_key
CLOUDINARY_API_SECRET=replace_with_test_secret
MESSAGE_ATTACHMENTS_ENABLED=false
MESSAGE_ATTACHMENT_STORAGE=cloudinary
MESSAGE_ATTACHMENT_DIR=/tmp/qnduit-private-attachments

# Empty disables unread counts. If enabled use a valid ISO UTC timestamp.
MESSAGE_UNREAD_SINCE=
NOTIFICATION_CAPTURE_ENABLED=false
NOTIFICATION_DELIVERY_ENABLED=false

# Only needed when deliberately running the admin creation script.
ADMIN_NAME=Local Admin
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace_with_a_unique_local_password

# Legacy Stripe code is not the mounted Flutterwave flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
